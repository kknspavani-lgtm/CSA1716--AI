        "\n",
        "def sum(n):\n",
        "    if n == 0:\n",
        "        return 0\n",
        "    return n + sum(n - 1)\n",
        "\n",
        "print(\"S =\", sum(5))\n",
        "print(\"S =\", sum(10))\n",
        "print(\"S =\", sum(100))\n"
