
% Fruit colour database
fruit_color(apple, red).
fruit_color(banana, yellow).
fruit_color(cherry, red).
fruit_color(grapes, green).
fruit_color(guava, green).
fruit_color(lemon, yellow).
fruit_color(orange, orange).
fruit_color(strawberry, red).

% Find fruits having the same colour
same_colour(F1, F2) :-
    fruit_color(F1, C),
    fruit_color(F2, C),
    F1 @< F2.

% Find all fruits of a particular colour
all_of_colour(C, L) :-
    findall(F, fruit_color(F, C), L).

% Display all fruits and their colours
show_all :-
    forall(
        fruit_color(F, C),
        format('~w is ~w~n', [F, C])
    ).
